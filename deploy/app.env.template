# Copy this file to /opt/protobuf-transfer/config/app.env on the instance
# and fill in real values. Never commit the filled-in version --
# app.env is gitignored.

# --- Core ports (positional args to TransferServer, substituted into
#     the systemd unit's ExecStart) ---
TCP_PORT=9000
HTTP_PORT=8080
UDP_PORT=9001

# --- TLS (optional; see generate-dev-certs.sh for local dev certs,
#     use a real certificate for anything beyond a development demo) ---
TLS_ENABLED=false
TLS_PORT=9443
TLS_KEYSTORE_PATH=/opt/protobuf-transfer/config/server-keystore.p12
TLS_KEYSTORE_PASSWORD=changeme

# --- CloudWatch ---
# Set to true only once the IAM role is attached and the AWS SDK
# dependency is present on the classpath (see pom.xml). If either isn't
# true yet, leave this false -- the app runs fine either way.
CLOUDWATCH_ENABLED=false
CLOUDWATCH_NAMESPACE=ProtobufTransferSystem
CLOUDWATCH_ENVIRONMENT=cloud

# --- Application logging (collected by the CloudWatch Agent -- see
#     cloudwatch-agent-config.json) ---
APP_LOG_PATH=/opt/protobuf-transfer/logs/application.log
