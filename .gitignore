target/

# Dev-only TLS certificates generated by generate-dev-certs.sh -- never commit these.
certs/
*.p12
*.jks
*.crt
*.pem
*.key

# Terraform state and variable files can contain resource IDs / IPs -- never commit these.
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfvars
terraform/.terraform.lock.hcl

# Filled-in deployment config (real ports/passwords) -- deploy/app.env.template is the committed reference; the real one is not.
deploy/app.env
